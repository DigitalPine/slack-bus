# slack-bus tokens
# Copy this file to `.env` and paste in your two Slack tokens.
# Bun auto-loads `.env` on `bun bus-mcp.ts`, so this is the foreground path.
# For the launchd path, set these in the .plist's EnvironmentVariables block.

# Bot User OAuth Token — from Slack admin → "Install App" → install to workspace
SLACK_BOT_TOKEN=xoxb-...

# App-Level Token — from Slack admin → "Basic Information" → "App-Level Tokens"
# → Generate Token (name it `slack-bus`, scope: `connections:write`)
SLACK_APP_TOKEN=xapp-...

# Optional — defaults shown
# SLACK_BUS_INSTANCE=default
# SLACK_BUS_PORT=42001

# Verbose inbound tracing (default off). Set to 1 when diagnosing
# "I'm not getting notifications" — logs every inbound event's outcome
# (matched N sessions / 0 sessions / dropped + reason). Noisy on busy
# workspaces; leave off in normal operation.
# SLACK_BUS_DEBUG=1
